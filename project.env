# Project settings. Sourced by scripts/*.sh, parsed by scripts/*.py (KEY=value lines only, no expansion beyond $HOME).
# Paths are relative to this repo's root unless absolute.

# The human's product repo. Agents read, build and test against it; never write.
# The template points at the worked example so it runs out of the box. Replace on adoption (lint.py --adoption checks).
HUMAN_REPO=examples/kv-python/product

# Where this template came from. scripts/lint.py --adoption fails and scripts/push.sh refuses while origin matches it:
# an adopter's sessions pushed to the template would publish their project.
TEMPLATE_ORIGIN=utilitydelta/proving-ground

# Optional: the repo agents build product code in ahead of the human. Empty disables lead.
LEAD_REPO=
# Branch in LEAD_REPO that factory units fast-forward.
LEAD_TRUNK=factory

# Space-separated dirs the factory runner mounts read-only inside its jail. HUMAN_REPO is always added.
FACTORY_READ_ONLY=

# Model for unattended factory orchestrators.
FACTORY_MODEL=opus

# Hard cap, in seconds, on one factory `claude -p` iteration. The runner also cuts it at the deadline plus
# FACTORY_FINISH_GRACE, whichever comes first.
FACTORY_ITERATION_TIMEOUT=5400

# Seconds past the --until deadline the factory runner keeps going to finish: it runs only jobs headed
# `# finish: yes` and one more iteration to complete `finish`, then stops.
FACTORY_FINISH_GRACE=3600

# Hard wall-clock cap, in seconds, for a scripts/run.sh run. A longer -t needs -H: past this it is a heavy run.
RUN_TIMEOUT=300

# Max heavy jobs (sweeps, fuzz, proofs, mutants, full suites) running at once on this machine. The slots live in
# HEAVY_DIR (default ~/.cache/proving-ground/heavy), shared by every clone on the machine.
HEAVY_JOBS=1

# Hard cap, in seconds, on a heavy run's -t and a factory job's `# timeout:`. A job asking for more is refused.
HEAVY_TIMEOUT_MAX=3600

# Memory cap for every harness run (scripts/run.sh) and every factory job and iteration: a systemd user scope with
# MemoryMax. Where no user scope can start (macOS, containers) runs go uncapped with a warning. An uncapped driver
# once grew to 24 GB and the OOM killer took the editor. Empty disables the cap.
MEMORY_MAX=8G

# Total size sessions/*/scratch may reach before scripts/lint.py fails (the pre-commit hook only warns).
SCRATCH_BUDGET=20G
